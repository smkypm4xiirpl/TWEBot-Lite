# Nama bot (tampil di banner console)
BOT_NAME=TWEBot-Lite

# Prefix command, pisahkan dengan koma. Contoh: .,!,/
PREFIXES=.

# Login memakai pairing code (tanpa QR).
# Kosongkan keduanya untuk diisi lewat prompt saat bot dijalankan.
# PAIRING_NUMBER: nomor WA bot, format internasional tanpa + dan tanpa 0 di depan.
# PAIRING_CODE  : kode kustom tepat 8 karakter (angka 1-9, huruf A-Z kecuali I, O, U).
# PERHATIAN: saat ini nilai kosong memakai kode default bawaan aplikasi
# (lihat src/config.js). Disarankan isi kode acak 8 karakter Anda sendiri
# (angka 1-9, huruf A-Z tanpa I/O/U) di .env privat.
PAIRING_NUMBER=
PAIRING_CODE=

# Default metadata sticker. Jika DEFAULT_AUTHOR kosong, author = nama WhatsApp pengirim.
DEFAULT_PACK=TWEBot
DEFAULT_AUTHOR=

# Opsional
OWNER_NUMBERS=
SESSION_DIR=session
MAX_INPUT_MB=25
MESSAGE_CONCURRENCY=5
FFMPEG_CONCURRENCY=2
# Akses grup default tertutup; owner dapat mengatur grup lewat .bot allow/disallow.
GROUP_DEFAULT=off
# Grup tujuan auto-forward media View Once (opsional, bisa diatur lewat .avo set <idGroup>)
# AVO_FORWARD_GROUP=1203630xxx@g.us
# FFMPEG_PATH=/usr/bin/ffmpeg
# LOG_LEVEL=debug
